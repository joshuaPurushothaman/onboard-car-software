# Device Configuration
# A unique identifier for this device (for example, "ic26-car")
# Used to prefix Kafka topics and connector names
DEVICE_NAME=

# Kafka Configuration
# The Kafka bootstrap servers to connect to (for example, "kafka.cat-crocodile.ts.net:9092")
CONNECT_BOOTSTRAP_SERVERS=

# The hostname that Kafka Connect will advertise to other services
# Typically this device's hostname on the network (for example, "my-device.cat-crocodile.ts.net")
CONNECT_REST_ADVERTISED_HOST_NAME=

# Redis Configuration (Optional)
# Port to expose Redis on localhost for the deserializer
# Avoid setting to 6379 to avoid conflicts with Redis instances on the host
# Default: 6380
# REDIS_PORT=6380

