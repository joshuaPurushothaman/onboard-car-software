{
    "name": "${DEVICE_NAME}-decoded-can-source",
    "config": {
      "connector.class": "com.redis.kafka.connect.RedisStreamSourceConnector",
      "redis.host": "redis",
      "redis.port": "6379",
      "redis.stream.name": "decoded-can",
      "redis.stream.offset": "0-0",
      "topic": "${DEVICE_NAME}-decoded-can",
      "tasks.max": "1"
    }
}

